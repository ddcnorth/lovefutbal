{
  "name": "lovefutbal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:prototypes": "vite --mode prototypes",
    "build": "vite build",
    "build:portal": "vite build --base=/p/lovefutbal/",
    "deploy:portal": "node scripts/deploy-portal.mjs",
    "build:prototypes": "vite build --mode prototypes --outDir dist-prototypes && node route-pages.js dist-prototypes",
    "preview": "vite preview",
    "preview:portal": "vite preview --base=/p/lovefutbal/",
    "preview:prototypes": "vite preview --mode prototypes --outDir dist-prototypes"
  },
  "dependencies": {
    "overlayscrollbars": "2.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.8"
  }
}
